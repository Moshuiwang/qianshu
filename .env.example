# 运行配置模板。复制为 .env 后在服务器上填写；.env 不进仓库。
# 不要把真实值写进本文件、Issue、PR 或聊天。

# 飞书自建应用（机器人）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 机器人汇报的群
FEISHU_CHAT_ID=

# 明道云开放接口（应用 → API 开发文档）
MINGDAO_APP_KEY=
MINGDAO_SIGN=
# 政策表的工作表 ID
MINGDAO_WORKSHEET_ID=

# 申请邮件所在邮箱（类型待定：飞书邮箱 / 企业邮箱 / Outlook）
MAIL_HOST=
MAIL_USER=
MAIL_PASSWORD=

# Claude API
ANTHROPIC_API_KEY=
