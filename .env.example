# 运行配置模板。复制为 .env 后在服务器上填写；.env 不进仓库。
# 不要把真实值写进本文件、Issue、PR 或聊天。

# 飞书自建应用（机器人）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 机器人汇报的群：运营配置Agent（产品文档 D12；chat_id 不是机密，机器人进群后用接口查得）
FEISHU_CHAT_ID=
# 申请存档所在知识库「海外运营中心」的一个已知页面，用于连通性检查（赞比亚 20261118）
FEISHU_WIKI_CHECK_NODE=

# 明道云：复用现有表单，用一个真实成员账号登录（产品文档 D10）
MINGDAO_ACCOUNT=
MINGDAO_PASSWORD=
# 以下是明道云内部标识，不是机密；取值见本机 .private/明道云录制-*.md
MINGDAO_BASE_URL=https://www.mingdao.com
# 「DVB政策」应用
MINGDAO_APP_ID=
MINGDAO_PROJECT_ID=
# 「优惠政策申请」表与其「新建」视图
MINGDAO_WORKSHEET_ID=
MINGDAO_VIEW_ID=
# 「提交申请」按钮（也是触发审批流程的 triggerId）
MINGDAO_SUBMIT_BTN_ID=

# 网易企业邮箱 IMAP（产品文档 10.2），密码处填客户端授权码
MAIL_HOST=imaphz.qiye.163.com
MAIL_USER=
MAIL_PASSWORD=

# Claude API
ANTHROPIC_API_KEY=
