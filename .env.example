# 运行配置模板。复制为 .env 后在服务器上填写；.env 不进仓库。
# 不要把真实值写进本文件、Issue、PR 或聊天。

# 飞书自建应用（机器人）
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 机器人汇报的群
FEISHU_CHAT_ID=

# 明道云：复用现有表单，用一个真实成员账号登录（产品文档 D10）
MINGDAO_ACCOUNT=
MINGDAO_PASSWORD=
# 「DVB政策」应用与「优惠政策申请」表的 ID（见浏览器地址栏）
MINGDAO_APP_ID=
MINGDAO_WORKSHEET_ID=

# 网易企业邮箱 IMAP（产品文档 10.2），密码处填客户端授权码
MAIL_HOST=imaphz.qiye.163.com
MAIL_USER=
MAIL_PASSWORD=

# Claude API
ANTHROPIC_API_KEY=
